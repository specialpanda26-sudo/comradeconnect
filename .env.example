# Comrade Connect: every setting the API reads. NO VALUES here.
# On Render: set each one under the service's Environment tab (full list and meaning: RENDER.md).
# For a local run: copy this file to .env, fill it in, then `export $(cat .env | xargs) && node server.js` (never commit .env).
# (Cloudflare Worker route: `npx wrangler secret put NAME`.)

# --- Database (Supabase) ---
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# --- Payments: PayHero only (see the PayHero block at the bottom) ---

# --- Site and cleanup job ---
ALLOWED_ORIGINS=https://comradeconnect.co.ke,https://www.comradeconnect.co.ke
CRON_SECRET=
GOOGLE_CLIENT_ID=

# --- Admin ---
ADMIN_KEY=

# --- Hashing (handover codes, recovery codes, ticket codes) ---
HASH_PEPPER=

# --- Free AI (Google AI Studio key, free tier, no card) ---
GEMINI_API_KEY=


# --- Trust and transparency (all optional; shown on /trust.html and /payments.html) ---
# OPERATOR_NAME=                 # legal or trading name, default "comradeconnect"
# OPERATOR_REG_NO=               # business registration number. Shown only if you set it.
# ODPC_REG_NO=                   # Office of the Data Protection Commissioner registration number. Shown only if you set it.
# OPERATOR_ADDRESS=              # default "Kerugoya, Kirinyaga, Kenya"
# SUPPORT_EMAIL=                 # default support@comradeconnect.co.ke
# SUPPORT_PHONE=                 # default: empty (no phone shown)
# DISPUTE_REVIEW_HOURS=48        # the promise made on the site: admins decide disputes within this many hours
# PAYOUT_TARGET_HOURS=24         # the promise made on the site: withdrawals paid within this many hours

# --- Email: student verification and forgot password (Brevo is free, about 300 emails a day: https://brevo.com) ---
# BREVO_API_KEY=                 # starts with xkeysib- . Server only. If set, Brevo is used.
# RESEND_API_KEY=                # alternative to Brevo (starts with re_). Used only when BREVO_API_KEY is not set.
# MAIL_FROM=                     # e.g. Comrade Connect <no-reply@comradeconnect.co.ke> (the domain must be verified at your mail provider)
# STUDENT_EMAIL_DOMAINS=ac.ke,strathmore.edu   # ac.ke = every Kenyan university; comma separated; subdomains such as students.kyu.ac.ke are accepted automatically

# --- Settings the code reads that were missing from this file ---
# SITE_URL=https://comradeconnect.co.ke
# PORT=10000                     # Render sets this itself
# AI_MODEL=gemini-3.1-flash-lite
# AI_DAILY_LIMIT=20
# AI_GLOBAL_LIMIT=1000
# BLOCKED_NAMES=                 # comma separated usernames nobody may take
# CLIP_MAX_MB=25
# MEDIA_BUCKET=cc-media
# PRIVATE_BUCKET=cc-private
# MEDIA_BUDGET_MB=800
# MEDIA_PUBLIC_URL=
# PENDING_MINUTES=
# REFERRAL_UNLOCK_DAYS=7
# WITHDRAW_REQUIRES_VERIFIED=1
# PWNED_CHECK=                   # 1 to reject passwords found in known leaks
# ODPC_REG_NO=                   # your Data Protection Commissioner registration number
# OPERATOR_NAME=
# OPERATOR_REG_NO=

# --- Live video (Agora, free 10,000 minutes a month) ---
# AGORA_APP_ID=                   # Agora Console > project > App ID. Must equal CC_AGORA_ID in frontend/config.js
# AGORA_APP_CERTIFICATE=          # Agora Console > project > Primary Certificate. Secret, server only

# --- Phone alerts (Android app only; website push is switched off) ---
# FCM_SERVICE_ACCOUNT=           # Firebase service account JSON (as is, or base64)

# --- Accounts and devices ---
# PASSKEY_RP_ID=comradeconnect.co.ke
# PASSKEY_ORIGINS=               # comma separated; default is the RP ID and its www. address
# DEVICE_LOCK=1                  # 1 = limit accounts per phone
# DEVICE_MAX_ACCOUNTS=3
# RESERVED_HANDLES=              # extra usernames nobody may take, comma separated
# ADMIN_EMAIL=                   # where support reports are mailed (falls back to SUPPORT_EMAIL)

# --- FinoQ (PayHero) v2 ---
PAYHERO_API_KEY=your_api_key_here
PAYHERO_API_SECRET=your_api_secret_here
PAYHERO_CHANNEL_ID=
PAYHERO_BASE_URL=https://backend.payhero.co.ke
# REQUIRED secret; CALLBACK_URL must end with ?s=<same secret>
PAYHERO_CALLBACK_SECRET=
CALLBACK_URL=https://yourdomain.com/api/webhooks/payhero?s=SECRET
PAYHERO_PAYOUTS_ENABLED=1
PAYOUT_AUTO_MIN=10
PAYOUT_AUTO_DAILY_MAX=150000
