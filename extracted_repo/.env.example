# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# IntaSend (backend processor — never surfaced by name in the UI, branded as "Ogolla" / "Ogolla Pay")
INTASEND_SECRET_KEY=
INTASEND_PUBLISHABLE_KEY=
# Use sandbox.intasend.com while testing, payment.intasend.com once live
INTASEND_BASE_URL=https://sandbox.intasend.com

# Public site URL, used to build the IntaSend webhook callback + referral share links
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# The exact "challenge" string you set when configuring the webhook in the
# IntaSend dashboard (Webhooks -> your endpoint -> challenge field). IntaSend
# echoes this back in every webhook payload; the webhook route rejects any
# request where it doesn't match, so this MUST be identical to what's in the
# dashboard.
INTASEND_WEBHOOK_CHALLENGE=

# Shared secret for admin-only API routes (currently: POST/GET
# /api/admin/release-payouts, which releases escrowed organizer payouts once
# an event's date has passed). Send it as the `x-admin-secret` header. Wire
# this up to a daily cron (Vercel Cron, Supabase pg_cron via net.http_post,
# or any scheduler that can send an authenticated HTTP request).
ADMIN_API_SECRET=
