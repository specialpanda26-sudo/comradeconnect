# Comrade Connect: every secret name the Worker uses. NO VALUES here.
# Set each one with:  npx wrangler secret put NAME
# For local testing with `wrangler dev`, copy this file to .dev.vars and fill it in (never commit .dev.vars).

# --- Database (Supabase) ---
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# --- Payments ---
# Default PAYMENT_MODE = "manual" needs NO secret (set MPESA_PAY_TO in wrangler.toml).
# Only if you switch PAYMENT_MODE to "tinypesa" (TinyPesa charges its own fees):
# TINYPESA_API_KEY=
# CALLBACK_SECRET=

# --- Admin ---
ADMIN_KEY=

# --- Hashing (handover codes, recovery codes, ticket codes) ---
HASH_PEPPER=

# --- Free AI (Google AI Studio key, free tier, no card) ---
GEMINI_API_KEY=

# --- Optional ---
# SENTRY_DSN=
