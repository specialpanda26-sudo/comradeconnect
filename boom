#!/data/data/com.termux/files/usr/bin/bash
# boom - one-word launcher for the Referral Tester bot (Comrade Connect).
#
# First run: sets up everything by itself - Debian (via proot-distro), Node, git,
# screen, Playwright + its Chromium browser, and a working copy of this repo inside
# that Debian - then starts the bot. No manual "proot-distro login" needed.
# Every run after that: resumes the bot if it is already going, or starts a fresh
# run if it finished or was stopped. Safe to run again any time.
#
# Usage, from Termux, at the folder where you cloned this repo:
#   bash boom
set -u
say() { echo "boom: $*"; }
die() { echo "boom: $*" >&2; exit 1; }

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]:-$0}")" && pwd)"
REPO_URL="$(git -C "$SCRIPT_DIR" config --get remote.origin.url 2>/dev/null)"
[ -n "$REPO_URL" ] || REPO_URL="https://github.com/specialpanda26-sudo/comradeconnect.git"
REPO_NAME="$(basename "$REPO_URL" .git)"

if [ -d /data/data/com.termux ] || [ -n "${TERMUX_VERSION:-}" ] || command -v proot-distro >/dev/null 2>&1; then
  :
else
  die "run this from the Termux app itself (not from inside Debian). If you are inside a 'proot-distro login' session, type 'exit' first, then run: bash boom"
fi

if ! command -v proot-distro >/dev/null 2>&1; then
  say "installing proot-distro (one-time)..."
  pkg update -y >/dev/null 2>&1
  pkg install -y proot-distro || die "could not install proot-distro. Check your internet and try again."
fi

if ! proot-distro list --installed 2>/dev/null | grep -qi '^debian'; then
  say "installing Debian (one-time, this can take a few minutes)..."
  proot-distro install debian || die "could not install Debian. Check your internet and try again."
fi

INNER_B64="$(base64 -w0 "$SCRIPT_DIR/.boom-inner.sh" 2>/dev/null || base64 "$SCRIPT_DIR/.boom-inner.sh" | tr -d '\n')"
[ -n "$INNER_B64" ] || die "could not find .boom-inner.sh next to this script - re-download the repo."

proot-distro login debian -- bash -c 'echo "$1" | base64 -d > /tmp/.boom-run.sh && exec bash /tmp/.boom-run.sh "$2" "$3"' _ "$INNER_B64" "$REPO_URL" "$REPO_NAME"
