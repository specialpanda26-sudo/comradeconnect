# Comrade Connect: every setting the API reads. NO VALUES here.
# On Render: set each one under the service's Environment tab (full list and meaning: RENDER.md).
# For a local run: copy this file to .env, fill it in, then `export $(cat .env | xargs) && node server.js` (never commit .env).
# (Cloudflare Worker route: `npx wrangler secret put NAME`.)

# --- Database (Supabase) ---
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# --- Payments ---
# Default PAYMENT_MODE = "manual" needs NO secret (set MPESA_PAY_TO in wrangler.toml).
# Only if you switch PAYMENT_MODE to "tinypesa" (TinyPesa charges its own fees):
# TINYPESA_LINK_API_KEY=
# TINYPESA_ACCOUNT_API_KEY=
# TINYPESA_USERNAME=
# CALLBACK_SECRET=

# --- Site and cleanup job ---
ALLOWED_ORIGINS=https://comradeconnect.co.ke,https://www.comradeconnect.co.ke
CRON_SECRET=
GOOGLE_CLIENT_ID=
PAYMENT_MODE=manual
MPESA_PAY_TYPE=send
MPESA_PAY_TO=
MPESA_PAY_NAME=

# --- Admin ---
ADMIN_KEY=

# --- Hashing (handover codes, recovery codes, ticket codes) ---
HASH_PEPPER=

# --- Free AI (Google AI Studio key, free tier, no card) ---
GEMINI_API_KEY=

